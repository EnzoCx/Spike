<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DPSMeter</AssemblyName>
    <Version>0.4.10</Version>
    <ApplicationIcon>Brand/dpsmeter.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DPSMeter.Core/DPSMeter.Core.csproj" />
    <ProjectReference Include="../DPSMeter.Engine/DPSMeter.Engine.csproj" />
    <Resource Include="Fonts/*" />
    <Resource Include="Brand/dpsmeter.ico" />
    <Resource Include="GameArt/**/*" />
    <Resource Include="../../brand/symbol.path" Link="Brand/symbol.path" />
    <Resource Include="../DPSMeter.Engine/Vendor/LICENSE" Link="Licenses/Engine.txt" />
    <Resource Include="../../LICENSE" Link="Licenses/DPSMeter.txt" />
    <Resource Include="../../THIRD-PARTY-NOTICES.md" Link="Licenses/ThirdParty.txt" />
  </ItemGroup>
</Project>
